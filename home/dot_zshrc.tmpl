#!/bin/env zsh

path=(~/.local/bin $path)

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

setopt CORRECT
setopt CORRECT_ALL
setopt INTERACTIVE_COMMENTS

{{- range .zshPlugins }}
source ~/.local/share/zsh/plugins/{{ .name }}/{{ .file }}
{{- end }}
fpath=(
{{- range .zshPlugins }}
  ~/.local/share/zsh/plugins/{{ .name }}
{{- end }}
  $fpath
)
export CLICOLOR=1
for f in ~/.config/zsh/prompt/*(N.); do source $f; done
# nvm and the default Node load eagerly: a process started before deferred
# loading runs (Claude Code and its hooks) would otherwise inherit a PATH with
# no node. --no-use skips nvm's slow default lookup; prepend its bin dir directly.
export NVM_DIR=~/.nvm
source $NVM_DIR/nvm.sh --no-use
path=($NVM_DIR/versions/node/v$(<$NVM_DIR/alias/default)*/bin(Nn[-1]) $path)
zsh-defer -c 'for f in ~/.config/zsh/envvars/*(N.); do source $f; done'
zsh-defer -c 'for f in ~/.config/zsh/aliases/*(N.); do source $f; done'

fpath+=~/.zfunc
zsh-defer -c 'autoload -Uz compinit && compinit && source $NVM_DIR/bash_completion'
# fzf's shell integration, regenerated only when the fzf binary changes.
if (( $+commands[fzf] )); then
  [[ ~/.cache/fzf.zsh -nt $commands[fzf] ]] || fzf --zsh >~/.cache/fzf.zsh 2>/dev/null
  source ~/.cache/fzf.zsh
fi

# Rebind fzf-git.sh from Ctrl-G to Alt-G
for m in emacs vicmd viins; do
  bindkey -M $m -r '^[g' 2>/dev/null  # unbind get-line so ^[g works as prefix
  for o in files branches tags remotes hashes stashes lreflogs each_ref worktrees; do
    bindkey -M $m -r "^g^${o[1]}" 2>/dev/null
    bindkey -M $m -r "^g${o[1]}" 2>/dev/null
    eval "bindkey -M $m '^[g^${o[1]}' fzf-git-$o-widget 2>/dev/null"
    eval "bindkey -M $m '^[g${o[1]}' fzf-git-$o-widget 2>/dev/null"
  done
  bindkey -M $m -r '^g?' 2>/dev/null
  bindkey -M $m '^[g?' 'fzf-git-?list_bindings-widget' 2>/dev/null
done

# Ctrl+Arrow word movement
bindkey '\e[1;5D' backward-word
bindkey '\e[1;5C' forward-word

# ^U deletes to start of line (zsh default is kill-whole-line)
bindkey '^U' backward-kill-line
