#!/bin/env zsh

typeset -U path
# Full path so Coder's Claude Code module finds it and doesn't append its own.
path=({{ .chezmoi.homeDir }}/.local/bin $path)

# Atuin output capture: re-exec this shell inside atuin's PTY proxy before
# anything else loads (atuin init would do it only at the end, after the whole
# zshrc has already run once). A no-op inside the proxy and for `zsh -c`.
if (( $+commands[atuin] )); then
  # A proxy that starts with no daemon running never captures, so start the
  # daemon first. Only in a new terminal's outer shell, which is about to exec.
  if [[ -t 0 && -t 1 && -z ${ATUIN_PTY_PROXY_ACTIVE-} && -z ${ZSH_EXECUTION_STRING-} ]]; then
    # `daemon status` exits 0 either way, so check what it prints.
    [[ $(atuin daemon status 2>/dev/null) == 'Daemon running'* ]] || atuin daemon restart &>/dev/null
  fi
  [[ ~/.cache/atuin-pty-proxy.zsh -nt $commands[atuin] ]] || atuin pty-proxy init zsh >~/.cache/atuin-pty-proxy.zsh 2>/dev/null
  source ~/.cache/atuin-pty-proxy.zsh
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

setopt CORRECT
setopt CORRECT_ALL
setopt INTERACTIVE_COMMENTS

{{- range .zshPlugins }}
source ~/.local/share/zsh/plugins/{{ .name }}/{{ .file }}
{{- end }}
fpath=(
{{- range .zshPlugins }}
  ~/.local/share/zsh/plugins/{{ .name }}
{{- end }}
  $fpath
)
export CLICOLOR=1
for f in ~/.config/zsh/prompt/*(N.); do source $f; done
# nvm and the default Node load eagerly: a process started before deferred
# loading runs (Claude Code and its hooks) would otherwise inherit a PATH with
# no node. --no-use skips nvm's slow default lookup; prepend its bin dir directly.
export NVM_DIR=~/.nvm
source $NVM_DIR/nvm.sh --no-use
path=($NVM_DIR/versions/node/v$(<$NVM_DIR/alias/default)*/bin(Nn[-1]) $path)
zsh-defer -c 'for f in ~/.config/zsh/envvars/*(N.); do source $f; done'
zsh-defer -c 'for f in ~/.config/zsh/aliases/*(N.); do source $f; done'

fpath+=~/.zfunc
zsh-defer -c 'autoload -Uz compinit && compinit && source $NVM_DIR/bash_completion'
# fzf's shell integration, regenerated only when the fzf binary changes.
if (( $+commands[fzf] )); then
  [[ ~/.cache/fzf.zsh -nt $commands[fzf] ]] || fzf --zsh >~/.cache/fzf.zsh 2>/dev/null
  source ~/.cache/fzf.zsh
fi
# Atuin after fzf so its Ctrl-R wins; it also registers itself as the first
# zsh-autosuggestions strategy. Its output depends on the config too, so it's
# regenerated when either the atuin binary or config.toml changes.
if (( $+commands[atuin] )); then
  [[ ~/.cache/atuin.zsh -nt $commands[atuin] && ~/.cache/atuin.zsh -nt ~/.atuin/config.toml ]] ||
    atuin init zsh >~/.cache/atuin.zsh 2>/dev/null
  source ~/.cache/atuin.zsh
fi

# Rebind fzf-git.sh from Ctrl-G to Alt-G
for m in emacs vicmd viins; do
  bindkey -M $m -r '^[g' 2>/dev/null  # unbind get-line so ^[g works as prefix
  for o in files branches tags remotes hashes stashes lreflogs each_ref worktrees; do
    bindkey -M $m -r "^g^${o[1]}" 2>/dev/null
    bindkey -M $m -r "^g${o[1]}" 2>/dev/null
    eval "bindkey -M $m '^[g^${o[1]}' fzf-git-$o-widget 2>/dev/null"
    eval "bindkey -M $m '^[g${o[1]}' fzf-git-$o-widget 2>/dev/null"
  done
  bindkey -M $m -r '^g?' 2>/dev/null
  bindkey -M $m '^[g?' 'fzf-git-?list_bindings-widget' 2>/dev/null
done

# Ctrl+Arrow word movement
bindkey '\e[1;5D' backward-word
bindkey '\e[1;5C' forward-word

# ^U deletes to start of line (zsh default is kill-whole-line)
bindkey '^U' backward-kill-line
