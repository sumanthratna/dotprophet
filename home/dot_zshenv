# Read by every zsh, interactive or not (agents' command shells, `zsh -c`), so
# exports go here rather than in .zshrc.

[[ -r ~/.cargo/env ]] && . ~/.cargo/env

typeset -U path
# The default Node from nvm, for every shell and the tools they start (MCP
# servers run through npx, agent hooks). Prepended directly, since
# `nvm use default` is slow; .zshrc loads nvm itself for the `nvm` command.
export NVM_DIR=~/.nvm
path=($NVM_DIR/versions/node/v$(<$NVM_DIR/alias/default)*/bin(Nn[-1]) $path)

export CLICOLOR=1

export BAT_THEME="Catppuccin Frappe"
export MANPAGER="sh -c 'col -bx | bat -plman'"
export MANROFFOPT="-c"

# Point eza and lazygit at the Catppuccin Frappe themes chezmoi downloads
# (.chezmoiexternal.toml.tmpl); on macOS they'd otherwise look in ~/Library.
export EZA_CONFIG_DIR="$HOME/.config/eza"
export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml"

export FZF_CTRL_T_OPTS="--preview 'bat -n --color=always {} 2>/dev/null || eza --color=always --icons --tree --level=2 {}'"
# Catppuccin Frappe: https://github.com/catppuccin/fzf
export FZF_DEFAULT_OPTS=" \
--color=bg+:#414559,bg:#303446,spinner:#F2D5CF,hl:#E78284 \
--color=fg:#C6D0F5,header:#E78284,info:#CA9EE6,pointer:#F2D5CF \
--color=marker:#BABBF1,fg+:#C6D0F5,prompt:#CA9EE6,hl+:#E78284 \
--color=selected-bg:#51576D \
--color=border:#737994,label:#C6D0F5"

# Raw color codes and quit-if-one-screen, for delta:
# https://github.com/dandavison/delta/issues/58
export LESS='FR'
